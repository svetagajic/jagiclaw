---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KontaktCta from '../components/KontaktCta.astro';
import { kancelarija, advokati, telefonLink } from '../data/kancelarija';
import { kancelarijaSchema } from '../data/schema';

const oblasti = (await getCollection('oblasti')).sort((a, b) => a.data.redosled - b.data.redosled);
const osnovne = oblasti.filter((o) => o.data.grupa === 'osnovna');
const dodatne = oblasti.filter((o) => o.data.grupa === 'dodatna');

const brzo = [
	{ tekst: 'Osnivam firmu', href: '/oblasti/privredno-pravo/' },
	{ tekst: 'Treba mi ugovor ili pregled ugovora', href: '/oblasti/trgovinsko-pravo/' },
	{ tekst: 'Dobio sam otkaz', href: '/oblasti/radno-pravo/' },
	{ tekst: 'Kupujem ili izdajem stan', href: '/oblasti/nepokretnosti/' },
	{ tekst: 'Neko mi duguje novac', href: '/oblasti/naplata-potrazivanja/' },
	{ tekst: 'Pozvan sam u policiju', href: '/oblasti/krivicno-pravo/' },
];

const koraci = [
	{ naslov: 'Javite se', tekst: 'Pozovite nas ili pošaljite e-mail sa kratkim opisom situacije i dokumentima koje imate.' },
	{ naslov: 'Procena', tekst: 'Kažemo vam koje su vaše mogućnosti, šta je rizik i šta predlažemo. Pre početka rada dogovaramo obim posla i način obračuna naknade.' },
	{ naslov: 'Rad na predmetu', tekst: 'Preuzimamo posao i redovno vas obaveštavamo. Uvek znate u kojoj je fazi vaš predmet i šta sledi.' },
];
---

<Base
	title="Advokatska kancelarija JagicLaw, Beograd | Privredno, radno i krivično pravo"
	description="Advokati Luka i Damjan Jagić, Beograd. Osnivanje firmi, ugovori, radno pravo, nepokretnosti, naplata potraživanja, krivično i prekršajno pravo. Srpski i engleski."
	schema={[kancelarijaSchema(oblasti.map((o) => o.data.naziv))]}
>
	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<p class="eyebrow">Advokatska kancelarija · {kancelarija.grad}</p>
				<h1>Pravna podrška za vaše poslovanje i vaše sporove</h1>
				<p class="lede">
					Advokati Luka i Damjan Jagić. Pomažemo firmama, preduzetnicima i građanima: od osnivanja društva i ugovora,
					preko radnih odnosa i nekretnina, do zastupanja pred sudom. Na srpskom i engleskom.
				</p>
				<div class="btn-row">
					<a class="btn" href={telefonLink}>Pozovite nas</a>
					<a class="btn btn-ghost" href="/kontakt/">Pošaljite upit</a>
				</div>
			</div>

			<div class="quick">
				<p class="quick-title">Najčešće nam se obraćaju jer:</p>
				<ul>
					{brzo.map((b) => <li><a href={b.href}>{b.tekst}<span aria-hidden="true">→</span></a></li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="section section-surface" id="oblasti">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Oblasti rada</p>
				<h2>Čime se bavimo</h2>
				<p>Najviše radimo sa firmama i preduzetnicima, a zastupamo i građane u sporovima, krivičnim i prekršajnim postupcima.</p>
			</div>
			<div class="cards">
				{osnovne.map((o) => (
					<a class="card" href={`/oblasti/${o.id}/`}>
						<h3>{o.data.naziv}</h3>
						<p>{o.data.kratko}</p>
						<span class="more">Saznajte više →</span>
					</a>
				))}
			</div>
			<div class="also">
				<p class="also-title">Takođe postupamo u oblastima:</p>
				<ul class="pill-list">
					{dodatne.map((o) => <li><a href={`/oblasti/${o.id}/`}>{o.data.naziv}</a></li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Kako radimo</p>
				<h2>Od prvog poziva do rešenja</h2>
			</div>
			<ol class="steps">
				{koraci.map((k, i) => (
					<li>
						<span class="step-num">{String(i + 1).padStart(2, '0')}</span>
						<h3>{k.naslov}</h3>
						<p>{k.tekst}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section section-surface">
		<div class="wrap split">
			<div>
				<p class="eyebrow">Advokati</p>
				<h2>Ko će raditi na vašem predmetu</h2>
				<p class="muted-text">Na vašem predmetu radi advokat sa kojim ste razgovarali, od prvog sastanka do kraja.</p>
				<a href="/advokati/">Više o nama →</a>
			</div>
			<div class="people">
				{advokati.map((a) => (
					<a class="person" href={`/advokati/#${a.slug}`}>
						<img class="avatar" src={a.foto} alt="" width="600" height="434" loading="lazy" />
						<div>
							<h3>{a.ime}</h3>
							<p class="role">{a.zvanje}</p>
							<p class="short">{a.kratko}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap split">
			<div>
				<p class="eyebrow">For international clients</p>
				<h2>Doing business in Serbia?</h2>
			</div>
			<div>
				<p>
					We advise foreign companies and individuals in English: company formation, bilingual contracts, bank accounts and KYC,
					real estate and employment.
				</p>
				<a href="/en/" hreflang="en">Read more in English →</a>
			</div>
		</div>
	</section>

	<KontaktCta />
</Base>

<style>
	.hero { padding-block: 3rem 4rem; background: linear-gradient(180deg, var(--surface) 0%, #fff 100%); }
	@media (min-width: 48rem) { .hero { padding-block: 5rem 6rem; } }
	.hero-grid { display: grid; gap: 3rem; align-items: center; }
	@media (min-width: 60rem) { .hero-grid { grid-template-columns: 1.35fr 1fr; gap: 4rem; } }
	.hero h1 { max-width: 16ch; }
	.hero .lede { margin-bottom: 2rem; }

	.quick { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 1.5rem; box-shadow: 0 24px 50px -32px rgba(14, 22, 33, 0.35); }
	.quick-title { font-weight: 600; color: var(--ink); margin-bottom: 0.5rem; }
	.quick ul { list-style: none; margin: 0; padding: 0; }
	.quick li + li { border-top: 1px solid var(--line); }
	.quick a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; color: var(--text); text-decoration: none; font-weight: 500; }
	.quick a span { color: var(--accent); transition: transform 0.15s; }
	.quick a:hover { color: var(--accent); }
	.quick a:hover span { transform: translateX(3px); }

	.also { margin-top: 2.5rem; }
	.also-title { font-weight: 600; color: var(--ink); }

	.steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
	@media (min-width: 52rem) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
	.steps li { border-top: 2px solid var(--ink); padding-top: 1.25rem; }
	.step-num { display: block; font-weight: 600; color: var(--accent); font-size: 0.95rem; margin-bottom: 0.75rem; font-variant-numeric: tabular-nums; }
	.steps p { color: var(--muted); margin: 0; }

	.split { display: grid; gap: 2rem; }
	@media (min-width: 52rem) { .split { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; } }
	.muted-text { color: var(--muted); }
	.people { display: grid; gap: 1rem; }
	.person { display: flex; align-items: center; gap: 1.25rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem; text-decoration: none; color: var(--text); transition: border-color 0.15s; }
	a.person:hover { border-color: var(--accent); color: var(--text); }
	.avatar { width: 5.5rem; height: 5.5rem; flex: none; border-radius: 50%; object-fit: cover; object-position: center 25%; }
	.person h3 { margin: 0; }
	.role { margin: 0; color: var(--accent); font-weight: 600; font-size: 0.95rem; }
	.short { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }
</style>
