---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pocetna from '../components/Pocetna.astro';
import { kancelarijaSchema } from '../data/schema';

const oblasti = await getCollection('oblasti');
---

<Base
	title="Advokatska kancelarija JagicLaw, Beograd | Privredno, radno i krivično pravo"
	description="Advokati Luka Jagić i Damjan Jagić, Beograd. Kancelarija okrenuta poslovanju: osnivanje privrednih društava, ugovori, radno pravo, nepokretnosti, naplata potraživanja, krivično i prekršajno pravo."
	schema={[kancelarijaSchema(oblasti.map((o) => o.data.naziv))]}
>
	<Pocetna />
</Base>
