---
import Base from '../layouts/Base.astro';
import KontaktCta from '../components/KontaktCta.astro';
import { advokati, kancelarija } from '../data/kancelarija';

const schema = advokati.map((a) => ({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: a.ime,
	jobTitle: a.zvanje,
	image: `${kancelarija.url}${a.foto}`,
	description: a.kratko,
	worksFor: { '@id': `${kancelarija.url}/#kancelarija` },
}));
---

<Base
	title="Advokati Luka Jagić i Damjan Jagić | JagicLaw, Beograd"
	description="Advokati Luka Jagić i Damjan Jagić iz Beograda: privredno i radno pravo, poslovni ugovori, zaštita podataka o ličnosti i podrška privrednim društvima, domaćim i stranim."
	schema={schema}
>
	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Advokati</p>
				<h1>Ko smo</h1>
				<p class="lede">
					JagicLaw je advokatska kancelarija iz Beograda okrenuta poslovanju. Na predmetima radimo zajedno i pratimo
					klijente kroz ceo životni ciklus posla: od osnivanja privrednog društva i svakodnevnog rada do rasta i upravljanja rizicima.
				</p>
			</div>

			<div class="bios">
				{advokati.map((a) => (
					<article class="bio" id={a.slug}>
						<img
							class="photo"
							src={a.foto}
							alt={`${a.ime}, ${a.zvanje.toLowerCase()}`}
							width="600"
							height="434"
							loading="lazy"
						/>
						<div class="bio-text">
							<h2>{a.ime}</h2>
							<p class="role">{a.zvanje}</p>
							{a.bio.map((p) => <p>{p}</p>)}
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section-surface">
		<div class="wrap split">
			<div>
				<p class="eyebrow">Kancelarija</p>
				<h2>Kako radimo</h2>
				<p class="muted-text">
					Spajamo strateški pravni savet sa praktičnom podrškom u svakodnevnom poslovanju, sa jasnim i primenljivim rešenjima.
				</p>
			</div>
			<ul class="checks">
				{kancelarija.prednosti.map((p) => <li>{p}</li>)}
			</ul>
		</div>
	</section>

	<KontaktCta />
</Base>

<style>
	.bios { display: grid; gap: 1.5rem; }
	@media (min-width: 56rem) { .bios { grid-template-columns: 1fr 1fr; } }
	.bio { background: var(--surface); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
	.photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 30%; }
	.bio-text { padding: 1.75rem; }
	.bio h2 { font-size: 1.6rem; margin-bottom: 0.15rem; }
	.role { color: var(--accent); font-weight: 600; margin-bottom: 1rem; }
	.split { display: grid; gap: 2rem; }
	@media (min-width: 52rem) { .split { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; } }
	.muted-text { color: var(--muted); }
</style>
