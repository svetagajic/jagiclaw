---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import KontaktCta from '../../components/KontaktCta.astro';
import { kancelarija, telefonLink } from '../../data/kancelarija';
import { faqSchema } from '../../data/schema';

export async function getStaticPaths() {
	const oblasti = (await getCollection('oblasti')).sort((a, b) => a.data.redosled - b.data.redosled);
	return oblasti.map((oblast) => ({ params: { slug: oblast.id }, props: { oblast, oblasti } }));
}

const { oblast, oblasti } = Astro.props;
const { naziv, naslov, seoNaslov, opis, usluge, faq } = oblast.data;
const { Content } = await render(oblast);
const ostale = oblasti.filter((o) => o.id !== oblast.id);

const schema: object[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: naziv,
		serviceType: naziv,
		description: opis,
		areaServed: { '@type': 'City', name: kancelarija.grad },
		provider: { '@id': `${kancelarija.url}/#kancelarija` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Početna', item: `${kancelarija.url}/` },
			{ '@type': 'ListItem', position: 2, name: 'Oblasti rada', item: `${kancelarija.url}/oblasti/` },
			{ '@type': 'ListItem', position: 3, name: naziv, item: `${kancelarija.url}/oblasti/${oblast.id}/` },
		],
	},
];
if (faq.length) schema.push(faqSchema(faq));
---

<Base title={seoNaslov} description={opis} schema={schema}>
	<section class="area-hero">
		<div class="wrap">
			<nav class="crumbs" aria-label="Putanja">
				<a href="/">Početna</a> <span aria-hidden="true">/</span> <a href="/oblasti/">Oblasti rada</a>
			</nav>
			<p class="eyebrow">{naziv}</p>
			<h1>{naslov}</h1>
			<p class="lede">{opis}</p>
			<div class="btn-row">
				<a class="btn" href={telefonLink}>Pozovite nas</a>
				<a class="btn btn-ghost" href="/kontakt/">Pošaljite upit</a>
			</div>
		</div>
	</section>

	<section class="wrap area-body">
		<div class="prose">
			<Content />
		</div>
		<aside class="services">
			<h2>Šta radimo</h2>
			<ul class="checks">
				{usluge.map((u) => <li>{u}</li>)}
			</ul>
		</aside>
	</section>

	{faq.length > 0 && (
		<section class="section section-surface">
			<div class="wrap faq-wrap">
				<h2>Česta pitanja</h2>
				<div class="faq">
					{faq.map((f) => (
						<details>
							<summary>{f.pitanje}</summary>
							<p>{f.odgovor}</p>
						</details>
					))}
				</div>
			</div>
		</section>
	)}

	<KontaktCta naslov={`Potreban vam je advokat za oblast: ${naziv.toLowerCase()}?`} />

	<section class="section">
		<div class="wrap">
			<h2 class="other-title">Ostale oblasti rada</h2>
			<ul class="pill-list">
				{ostale.map((o) => <li><a href={`/oblasti/${o.id}/`}>{o.data.naziv}</a></li>)}
			</ul>
		</div>
	</section>
</Base>

<style>
	.area-hero { padding-block: 2.5rem 3.5rem; border-bottom: 1px solid var(--line); background: linear-gradient(180deg, var(--surface), #fff); }
	@media (min-width: 48rem) { .area-hero { padding-block: 3.5rem 4.5rem; } }
	.area-hero h1 { max-width: 20ch; }
	.area-hero .lede { margin-bottom: 1.75rem; }
	.crumbs { font-size: 0.9rem; color: var(--muted); margin-bottom: 1.75rem; }
	.crumbs a { color: var(--muted); text-decoration: none; }
	.crumbs a:hover { color: var(--accent); }

	.area-body { display: grid; gap: 2.5rem; padding-block: 3.5rem 4.5rem; }
	@media (min-width: 60rem) { .area-body { grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: start; } }
	.prose { font-size: 1.1rem; max-width: 40rem; }
	.prose :global(p) { margin-bottom: 1.25rem; }
	.services { background: var(--surface); border-radius: var(--radius); padding: 1.75rem; }
	@media (min-width: 60rem) { .services { position: sticky; top: 6rem; } }
	.services h2 { font-size: 1.3rem; margin-bottom: 1.1rem; }

	.faq-wrap { max-width: 50rem; }
	.faq { display: grid; gap: 0.75rem; }
	.faq details { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 0 1.4rem; }
	.faq summary { cursor: pointer; list-style: none; font-weight: 600; color: var(--ink); padding-block: 1.15rem; display: flex; justify-content: space-between; gap: 1rem; }
	.faq summary::-webkit-details-marker { display: none; }
	.faq summary::after { content: '+'; font-size: 1.4rem; line-height: 1; color: var(--accent); }
	.faq details[open] summary::after { content: '–'; }
	.faq details p { margin: 0 0 1.25rem; color: var(--text); }

	.other-title { font-size: 1.4rem; margin-bottom: 1.25rem; }
</style>
