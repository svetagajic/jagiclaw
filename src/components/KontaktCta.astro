---
import { kancelarija, telefonLink, emailLink } from '../data/kancelarija';

interface Props {
	naslov?: string;
	tekst?: string;
	en?: boolean;
}

const {
	en = false,
	naslov = en ? 'Tell us about your situation' : 'Opišite nam svoju situaciju',
	tekst = en
		? 'Call or write to us. We will tell you what your options are and what the next step is.'
		: 'Pozovite nas ili pošaljite e-mail. Reći ćemo vam koje su vaše mogućnosti i šta je sledeći korak.',
} = Astro.props;
---

<section class="cta-band" id={en ? 'contact' : undefined}>
	<div class="wrap cta-inner">
		<div>
			<h2>{naslov}</h2>
			<p>{tekst}</p>
		</div>
		<div class="cta-actions">
			<a class="btn" href={telefonLink}>{en ? kancelarija.telefonEn : kancelarija.telefon}</a>
			<a class="btn btn-ghost" href={emailLink}>{kancelarija.email}</a>
		</div>
	</div>
</section>

<style>
	.cta-band { background: var(--accent); color: #dbe5f4; padding-block: 3.5rem; }
	.cta-inner { display: grid; gap: 1.75rem; align-items: center; }
	@media (min-width: 52rem) { .cta-inner { grid-template-columns: 1.3fr 1fr; gap: 3rem; } }
	h2 { color: #fff; }
	p { margin: 0; max-width: 36rem; font-size: 1.08rem; }
	.cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
	@media (min-width: 52rem) { .cta-actions { justify-content: flex-end; } }
	.btn { background: #fff; color: var(--accent); border-color: #fff; }
	.btn:hover { background: var(--accent-soft); border-color: var(--accent-soft); color: var(--accent-hover); }
	.btn-ghost { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.55); }
	.btn-ghost:hover { background: rgba(255, 255, 255, 0.1); color: #fff; border-color: #fff; }
</style>
